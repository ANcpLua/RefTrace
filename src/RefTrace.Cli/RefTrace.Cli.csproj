<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ref</ToolCommandName>
    <PackageId>RefTrace</PackageId>
    <Description>Trace resolved .NET dependencies and inspect assembly metadata without loading target assemblies.</Description>
    <PackageTags>dotnet;dependencies;nuget;metadata;architecture</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ANcpLua/RefTrace</PackageProjectUrl>
    <Copyright>Copyright (c) 2026 Alexander Nachtmann and RefTrace contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="../../tooling/reftrace_audit/*.py" Link="audit/reftrace_audit/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../tooling/audit-probes.json" Link="audit/probes.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="RefTrace.Tests" />
    <ProjectReference Include="../RefTrace.Model/RefTrace.Model.csproj" />
    <ProjectReference Include="../RefTrace.Metadata/RefTrace.Metadata.csproj" />
    <ProjectReference Include="../RefTrace.Assets/RefTrace.Assets.csproj" />
    <ProjectReference Include="../RefTrace.Runtime/RefTrace.Runtime.csproj" />
    <ProjectReference Include="../RefTrace.Build/RefTrace.Build.csproj" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Spectre.Console" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../ARCHITECTURE.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/PACKAGE-AUDIT.md" Pack="true" PackagePath="/docs" />
    <None Include="../../docs/REFERENCE.md" Pack="true" PackagePath="/docs" />
    <None Include="../../docs/ASYNC-THREADING.md" Pack="true" PackagePath="/docs" />
    <None Include="../../docs/SELF-REVIEW.md" Pack="true" PackagePath="/docs" />
    <None Include="../../docs/TRANSITIVE-REVIEW.md" Pack="true" PackagePath="/docs" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../licenses/**/*" Exclude="../../licenses/**/.DS_Store" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
</Project>
